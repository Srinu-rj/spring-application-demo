#Sample Logstash configuration for creating a simple
#Beats -> Logstash -> Elasticsearch pipeline.

input {
  file {
     type => "log"
     path => "ElasticSerch\elastic-log\application.log"
     }
}
filter {
   if [message
     ] =~ "\tat" {
     grok {
      match => [
                "message",
                "^(\tat)"
            ]
      add_tag => [
                "stacktrace"
             ]
         }
      }
}

output {
  elasticsearch { hosts => [
             "https://localhost:9200/"
          ]
    index => "logfromfilebeat-%{+YYYY.MM.dd}"
    user => "elastic"
    password => "S9gOv6aITJAEfhTrbP5Z"
    ssl => true
    ssl_certificate_verification => false
    }
}